# ─────────────────────────────────────────────────────────────────────────────
# PAVS Stack – Runtime Configuration
# Copy to .env and adjust for your deployment.
# Docker Compose automatically loads .env from the same directory.
# ─────────────────────────────────────────────────────────────────────────────

# Public-facing base URL (scheme + host [+ port]), no trailing slash.
# Used as VITE_API_URL so the browser knows where to reach the API.
# Leave blank when nginx is the single entry point (recommended for production)
# so the frontend uses relative paths and nginx proxies /api/ to the backend.
#
# Examples:
#   PAVS_PUBLIC_URL=                           # relative paths (production default)
#   PAVS_PUBLIC_URL=http://localhost:3000      # local docker-compose dev
#   PAVS_PUBLIC_URL=https://pavs.phenomebrowser.net
PAVS_PUBLIC_URL=

# ── Host ports (what Docker exposes on the host machine) ──────────────────────
# In production you typically only need the frontend port (80 or 443).
# Backend and Virtuoso can be firewalled / not exposed at all.
PAVS_FRONTEND_PORT=3000
PAVS_BACKEND_PORT=8000
PAVS_VIRTUOSO_HTTP_PORT=8890
PAVS_VIRTUOSO_SQL_PORT=1111

# ── Virtuoso database password ────────────────────────────────────────────────
# Change before production deployment.
VIRT_DBA_PASSWORD=pavs_dba
